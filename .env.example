# .env.example — 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# cp .env.example .env

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-northeast-2
# 로컬 <-> EC2 간 data/processed, model/checkpoints 동기화 및 스팟 인터럽션
# 백업에 사용 (experiments/aws/sync_to_s3.sh, bootstrap_ec2.sh, spot_backup_watcher.sh)
DEEPLOG_S3_BUCKET=your-s3-bucket-name

# ── Kafka ─────────────────────────────────────────────────────────────────────
# 호스트(로컬 또는 EC2)에서 producer/consumer 실행 시
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# 컨테이너 내부에서 Kafka에 접근할 때는 kafka:29092 사용
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:29092
KAFKA_TOPIC_HDFS=deeplog-hdfs
KAFKA_TOPIC_BGL=deeplog-bgl

# ── 학습 / 데이터 ──────────────────────────────────────────────────────────────
DATASET=hdfs                        # hdfs | bgl
# docker compose로 띄울 때는 DEEPLOG_DATASET(hdfs|bgl)이 세 서빙 컨테이너의 모델을 한 번에 고른다
DEEPLOG_DATASET=hdfs
CKPT_DIR=model/checkpoints/hdfs     # 학습 완료 후 생성

# ── FastAPI (port 8000) ────────────────────────────────────────────────────────
# DATASET, CKPT_DIR 위 값을 그대로 사용

# ── BentoML (port 3000) ───────────────────────────────────────────────────────
BENTOML_MODEL_NAME=deeplog-hdfs     # save_model.py가 deeplog-<dataset>으로 등록
BENTOML_MODEL_TAG=latest

# ── Triton (port 8001 서버 / 8002 래퍼) ──────────────────────────────────────
TRITON_URL=localhost:8001
MODEL_NAME=deeplog
MODEL_REPO=serving/triton/models/hdfs   # setup_model.py가 데이터셋별로 생성
